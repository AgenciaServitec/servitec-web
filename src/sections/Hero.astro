---
import ContentWidth from "../components/ContentWidth.astro";
import Avatar from "../components/Avatar.astro";

const pages = [
    {
        image:"/image/logotipo-hard.webp",
        link:"servitecperu.com"
    },
    {
        image:"/image/logotipo-soft.png",
        link:"servitec.site"
    }
]
---

<section class="relative flex min-h-[100vh] flex-col items-center justify-center overflow-hidden py-20">

    <ContentWidth>
        <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center text-center" data-hero>

            <p
                    class="hero-title mb-6 flex items-center justify-center gap-3 text-xl md:text-2xl font-semibold tracking-wide text-primary"
                    data-hero-item
            >
                SERVITEC PERÚ
            </p>

            <h1 class="hero-title text-balance italic text-3xl uppercase cursive font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl leading-[1.15]" data-hero-item>
                Soporte técnico y desarrollo <br class="hidden md:block" />

                <span class="hero-gradient text-transparent bg-clip-text bg-gradient-to-r from-primary via-yellow-400 to-amber-600">
                    de software a medida
                </span>
            </h1>

            <div id="character-container" class="mt-16 mb-2 relative" data-hero-item>
                <div class="absolute inset-0 bg-primary/15 blur-3xl rounded-full scale-150 -z-10"></div>

                <Avatar class="h-[13rem] w-auto origin-bottom drop-shadow-xl" />
            </div>

            <div class="mt-24 w-full max-w-4xl" data-hero-item>
                <div class="flex flex-col items-center justify-center gap-12 sm:flex-row md:gap-24">
                    {pages.map((page) => (
                            <a
                                    href={`https://${page.link}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="group relative flex items-center justify-center transition-all duration-300 hover:-translate-y-2"
                                    aria-label={`Ir a ${page.link}`}
                            >
                                <img
                                        src={page.image}
                                        class="relative z-10 h-20 w-auto transition-all duration-300 group-hover:scale-110 md:h-28 logo-glow"
                                        alt={`Logotipo de ${page.link}`}
                                />
                            </a>
                    ))}
                </div>
            </div>
        </div>
    </ContentWidth>

    <style>
        .hero-title {
            text-shadow:
                    0 2px 10px rgba(0,0,0,0.6),
                    0 0 20px rgba(59,130,246,0.4),
                    0 0 40px rgba(59,130,246,0.2);
        }

        .hero-gradient {
            text-shadow:
                    0 2px 10px rgba(0,0,0,0.6),
                    0 0 15px rgba(251,191,36,0.5),
                    0 0 30px rgba(251,191,36,0.3);
        }

        .hero-subtitle {
            text-shadow:
                    0 2px 8px rgba(0,0,0,0.7),
                    0 0 10px rgba(59,130,246,0.3);
        }

        .logo-glow {
            filter: drop-shadow(0 0 15px rgba(250, 204, 21, 0.2));
            transition: all 0.5s cubic-bezier(0.13, 1, 0.22, 1);
        }

        a.group:hover .logo-glow {
            filter:
                    drop-shadow(0 0 10px rgba(250, 204, 21, 0.6))
                    brightness(1.2);
            transform: scale(1.01);
        }

        [data-hero-item] {
            opacity: 0;
        }
    </style>
    <script>
        import "../scripts/heroAnimation.js";
    </script>
</section>