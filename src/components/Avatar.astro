---
interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<div id="character-container" class={`relative ${className}`}>
    <div class="absolute inset-0 bg-primary/20 blur-[80px] rounded-full scale-110 -z-10"></div>

    <svg
            id="technician-avatar"
            viewBox="0 0 120 150"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="h-full w-auto drop-shadow-2xl"
    >
        <defs>
            <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FFF5F0" />
                <stop offset="100%" stop-color="#FFDFC4" />
            </linearGradient>

            <linearGradient id="hairGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#3D2B1F" />
                <stop offset="100%" stop-color="#241811" />
            </linearGradient>

            <filter id="innerShadow">
                <feOffset dx="0" dy="2" />
                <feGaussianBlur stdDeviation="2" result="offset-blur" />
                <feComposite operator="out" in="SourceGraphic" in2="offset-blur" result="inverse" />
                <feFlood flood-color="black" flood-opacity="0.1" result="color" />
                <feComposite operator="in" in="color" in2="inverse" result="shadow" />
                <feComposite operator="over" in="shadow" in2="SourceGraphic" />
            </filter>
        </defs>

        <ellipse cx="60" cy="140" rx="40" ry="6" fill="black" fill-opacity="0.1" />

        <path d="M50 80 L 50 115 L 70 115 L 70 80 Z" fill="#F3D0B5" />

        <g id="body-group" class="will-change-transform">
            <path d="M20 140 C 20 110, 40 100, 60 100 C 80 100, 100 110, 100 140 L 100 150 L 20 150 Z" fill="#1E293B" />
            <path d="M45 102 L 60 115 L 75 102" stroke="#334155" stroke-width="4" stroke-linecap="round" fill="none" />
            <path d="M55 125 L 52 128 L 55 131 M65 125 L 68 128 L 65 131" stroke="#3B82F6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.8" />
        </g>

        <g id="head-group" class="will-change-transform">

            <path d="M30 60 C 30 35, 90 35, 90 60 C 90 88, 75 98, 60 98 C 45 98, 30 88, 30 60 Z" fill="url(#skinGrad)" filter="url(#innerShadow)" />

            <circle cx="30" cy="65" r="6" fill="#FFDFC4" />
            <circle cx="90" cy="65" r="6" fill="#FFDFC4" />

            <g id="face-group">
                <path d="M40 50 Q 47 47, 53 50" stroke="#3D2B1F" stroke-width="2.5" stroke-linecap="round" />
                <path d="M67 50 Q 73 47, 80 50" stroke="#3D2B1F" stroke-width="2.5" stroke-linecap="round" />

                <circle cx="47" cy="62" r="8" fill="white" />
                <circle cx="73" cy="62" r="8" fill="white" />

                <g id="pupils-group">
                    <circle cx="47" cy="62" r="4.5" fill="#1A1A1A" />
                    <circle cx="73" cy="62" r="4.5" fill="#1A1A1A" />
                    <circle cx="45.5" cy="60.5" r="1.5" fill="white" />
                    <circle cx="71.5" cy="60.5" r="1.5" fill="white" />
                </g>

                <path d="M60 62 Q 63 72, 58 74" stroke="#DCA884" stroke-width="2" stroke-linecap="round" fill="none" />

                <path d="M52 85 Q 60 90, 68 85" stroke="#C28C67" stroke-width="2.5" stroke-linecap="round" fill="none" />
            </g>

            <g id="hair-group" fill="url(#hairGrad)">
                <circle cx="40" cy="35" r="12" />
                <circle cx="60" cy="30" r="14" />
                <circle cx="80" cy="35" r="12" />
                <circle cx="30" cy="50" r="10" />
                <circle cx="90" cy="50" r="10" />
                <circle cx="50" cy="28" r="12" />
                <circle cx="70" cy="28" r="12" />
                <path d="M30 50 Q 25 65, 30 70" stroke="url(#hairGrad)" stroke-width="8" stroke-linecap="round" />
                <path d="M90 50 Q 95 65, 90 70" stroke="url(#hairGrad)" stroke-width="8" stroke-linecap="round" />
                <path d="M35 45 C 40 20, 80 20, 85 45 C 75 35, 45 35, 35 45 Z" />
            </g>
        </g>
    </svg>
</div>